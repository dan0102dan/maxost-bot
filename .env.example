# Recommended: python3 scripts/configure.py creates .env with secure random values.
# Never commit .env. Back up ENCRYPTION_KEYS separately from the database.
TELEGRAM_BOT_TOKEN=replace_with_BotFather_token
POSTGRES_PASSWORD=replace_with_random_urlsafe_password
ENCRYPTION_KEYS=replace_with_base64_32_byte_key
MAX_ACCOUNTS=100
WORKERS=4
AUTH_TTL_SECONDS=600
MAX_FILE_MB=20
HISTORY_MAX_PAGES=20
HISTORY_INTERVAL_SECONDS=120
RETENTION_DAYS=30
RICH_UI=true
# Leave empty for public registration. Set IDs for an initial private test.
ALLOWED_TELEGRAM_IDS=
